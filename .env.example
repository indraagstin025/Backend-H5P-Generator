# Salin ke .env untuk lokal.
DATABASE_URL="postgresql://postgres@localhost:5432/H5P_Generator?schema=public"
PORT=3000
STORAGE_DIR="./storage"
# Opsional: folder library lokal untuk npm run h5p:seed.
# Default mencoba ../Frontend-H5P-Generator/public/h5p-libraries sebelum H5P Hub.
# H5P_LIBRARY_SOURCE="../Frontend-H5P-Generator/public/h5p-libraries"
# Wajib diisi minimal 32 karakter acak untuk produksi:
JWT_SECRET="ganti-dengan-rahasia-jwt-minimal-32-karakter-acak"
JWT_EXPIRES_IN="7d"
# Daftar origin frontend yang diizinkan (pisahkan koma untuk produksi):
# CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
FRONTEND_URL="http://localhost:5173"
# Google OAuth 2.0 (isi Client ID & Secret dari Google Cloud Console):
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Render OnlyOffice (kosong = nonaktif, latar pending):
# ONLYOFFICE_URL="http://localhost:8080"
# ONLYOFFICE_JWT="ganti-rahasia-ini"
# ONLYOFFICE_FILE_URL_BASE="http://localhost:3000"
# ONLYOFFICE_TIMEOUT_MS=300000
MAX_UPLOAD_BYTES=52428800
MAX_SLIDES_PER_PROJECT=60
TEMP_TTL_HOURS=24
CLEANUP_INTERVAL_MS=3600000
# debug | info | warn | error | silent
LOG_LEVEL=info
# Opsional: override kredensial seeder (wajib diisi pada NODE_ENV=production saat menjalankan npm run db:seed)
# SEED_ADMIN_EMAIL="admin.h5p@gmail.com"
# SEED_ADMIN_NAME="Administrator H5P"
# SEED_ADMIN_PASSWORD=""
# SEED_USER_EMAIL="user.h5p@gmail.com"
# SEED_USER_NAME="Pengguna H5P"
# SEED_USER_PASSWORD=""
